    {
      "id": "claim_91287ccec02148c08a9c50ef7e5ba64c",
      "statement": "The @tool decorator registers an async wrapper with mcp 2.x's MCPServer that resolves the calling Session from the request headers in mcp_context, binds it into a ContextVar and runs the sync body in a worker thread under both the Session's limiter and the process-wide runtime.workers limiter, returning the original function unchanged for in-process callers.",
      "evidence": [
        {
          "resource": "repo://dtcc_agent/server.py#L236-L300",
          "version": "repo-lines-v1:sha256:777b34e475d8803104553e2afbd2f16497b0d57013227087f9369e59b14ebc6d:"
        }
      ]
    },
    {
      "id": "claim_3ec61768bb084bf6a2a2f98d84782eba",
      "statement": "The process-wide worker pool size comes from DTCC_MCP_WORKERS (default 4), is validated at import to be a whole number >= 1, and each HTTP Session may use at most max(1, WORKERS // 2) of it.",
      "evidence": [
        {
          "resource": "repo://dtcc_agent/runtime.py#L17-L29",
          "version": "repo-lines-v1:sha256:326d737302e4947ee95511f736175460bd71ae69f14fe82a955d95c19321bbda:"
